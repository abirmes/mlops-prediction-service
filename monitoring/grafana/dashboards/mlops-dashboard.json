{
  "dashboard": {
    "title": "MLOps - Service de Prédiction",
    "tags": ["mlops", "machine-learning", "api"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    
    "panels": [
      {
        "id": 1,
        "title": "📊 Nombre Total de Prédictions",
        "type": "stat",
        "targets": [
          {
            "expr": "predictions_total",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 100, "color": "yellow"},
                {"value": 1000, "color": "red"}
              ]
            }
          }
        }
      },
      
      {
        "id": 2,
        "title": "⚡ Requêtes par Minute",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(predictions_total[1m]) * 60",
            "legendFormat": "Prédictions/min",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "yaxes": [
          {"format": "short", "label": "Req/min"},
          {"format": "short"}
        ]
      },
      
      {
        "id": 3,
        "title": "⏱️ Latence des Prédictions",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 (médiane)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "yaxes": [
          {"format": "s", "label": "Temps"},
          {"format": "short"}
        ]
      },
      
      {
        "id": 4,
        "title": "❌ Taux d'Erreurs",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(prediction_errors_total[5m]) * 100",
            "legendFormat": "Erreurs (%)",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12},
        "yaxes": [
          {"format": "percent", "label": "Erreurs"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [5], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "Taux d'erreurs élevé",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      
      {
        "id": 5,
        "title": "📈 Statut de l'API",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job='mlops-api'}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 8, "y": 12},
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "🟢 UP"},
              {"type": "value", "value": "0", "text": "🔴 DOWN"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      
      {
        "id": 6,
        "title": "🔢 Nombre Total d'Erreurs",
        "type": "stat",
        "targets": [
          {
            "expr": "prediction_errors_total",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 12},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      
      {
        "id": 7,
        "title": "📊 Requêtes par Endpoint",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (endpoint) (api_requests_total)",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}
      },
      
      {
        "id": 8,
        "title": "⏰ Temps Moyen de Prédiction",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate(prediction_duration_seconds_sum[5m]) / rate(prediction_duration_seconds_count[5m])",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 18},
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      }
    ]
  }
}